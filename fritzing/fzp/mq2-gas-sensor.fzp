<?xml version="1.0" encoding="UTF-8"?>
<module fritzingVersion="1.0.2" moduleId="makerbuddy-kit-mq2-gas-sensor-r4" referenceFile="mq2-gas-sensor.fzp">
 <version>1</version>
 <author>MakerBuddy (https://makerbuddy.cc)</author>
 <title>MQ-2 gas and smoke sensor with its cable (MakerBuddy)</title>
 <label>MQ</label>
 <date>2026-11-24</date>
 <url>https://github.com/MakerBuddy/MakerBuddy-IoT-Kit-Fritzing-Parts</url>
 <tags>
  <tag>MakerBuddy</tag>
  <tag>IoT Kit</tag>
  <tag>MQ-2</tag>
  <tag>gas</tag>
  <tag>smoke</tag>
  <tag>sensor</tag>
  <tag>analog</tag>
 </tags>
 <properties>
  <property name="family">MakerBuddy gas and smoke sensor</property>
  <property name="type">gas and smoke sensor</property>
  <property name="sensor">MQ-2</property>
  <property name="interface">analog</property>
  <property name="connector">JST-XH 3-pin</property>
  <property name="board connector">33</property>
  <property name="cable">kit cable with plug</property>
 </properties>
 <description>MQ-2 combustible gas and smoke sensor (Flying-Fish module) with the MakerBuddy JST adapter. 3-pin JST-XH socket: AO (printed AD), VCC, GND. Plugs into connector 33 of the MakerBuddy IoT Kit board. The can gets warm while it works. This part comes with the kit's 3-wire cable and its plug: drop the plug on connector 33 of the MakerBuddy IoT Kit board and all 3 pins connect at once. https://makerbuddy.cc</description>
 <views>
  <iconView>
   <layers image="icon/mq2-gas-sensor_icon.svg">
    <layer layerId="icon"/>
   </layers>
  </iconView>
  <breadboardView>
   <layers image="breadboard/mq2-gas-sensor_breadboard.svg">
    <layer layerId="breadboard"/>
   </layers>
  </breadboardView>
  <schematicView>
   <layers image="schematic/mq2-gas-sensor_schematic.svg">
    <layer layerId="schematic"/>
   </layers>
  </schematicView>
  <pcbView>
   <layers image="pcb/mq2-gas-sensor_pcb.svg">
    <layer layerId="copper0"/>
    <layer layerId="silkscreen"/>
    <layer layerId="copper1"/>
   </layers>
  </pcbView>
 </views>
 <connectors>
  <connector id="connector0" name="AO" type="male">
   <description>Analog output: rises with smoke and gas. On the board: connector 33 (GPIO 33).</description>
   <views>
    <breadboardView><p layer="breadboard" svgId="connector0pin" hybrid="yes"/></breadboardView>
    <schematicView><p layer="schematic" svgId="connector0pin" terminalId="connector0terminal"/></schematicView>
    <pcbView><p layer="copper0" svgId="connector0pin"/><p layer="copper1" svgId="connector0pin"/></pcbView>
   </views>
  </connector>
  <connector id="connector1" name="VCC" type="male">
   <description>5 V supply (the heater draws about 150 mA)</description>
   <views>
    <breadboardView><p layer="breadboard" svgId="connector1pin" hybrid="yes"/></breadboardView>
    <schematicView><p layer="schematic" svgId="connector1pin" terminalId="connector1terminal"/></schematicView>
    <pcbView><p layer="copper0" svgId="connector1pin"/><p layer="copper1" svgId="connector1pin"/></pcbView>
   </views>
  </connector>
  <connector id="connector2" name="GND" type="male">
   <description>Ground</description>
   <views>
    <breadboardView><p layer="breadboard" svgId="connector2pin" hybrid="yes"/></breadboardView>
    <schematicView><p layer="schematic" svgId="connector2pin" terminalId="connector2terminal"/></schematicView>
    <pcbView><p layer="copper0" svgId="connector2pin"/><p layer="copper1" svgId="connector2pin"/></pcbView>
   </views>
  </connector>
 </connectors>
 <buses>
 </buses>
</module>
