<?xml version="1.0" encoding="UTF-8"?>
<module fritzingVersion="1.0.2" moduleId="makerbuddy-kit-dc-motor-fan-r1" referenceFile="dc-motor-fan.fzp">
 <version>1</version>
 <author>MakerBuddy (https://makerbuddy.cc)</author>
 <title>DC motor with fan (MakerBuddy)</title>
 <label>M</label>
 <date>2026-11-24</date>
 <url>https://github.com/MakerBuddy/MakerBuddy-IoT-Kit-Fritzing-Parts</url>
 <tags>
  <tag>MakerBuddy</tag>
  <tag>IoT Kit</tag>
  <tag>DC motor</tag>
  <tag>fan</tag>
  <tag>propeller</tag>
  <tag>actuator</tag>
 </tags>
 <properties>
  <property name="family">MakerBuddy DC motor with fan</property>
  <property name="type">DC motor with fan</property>
  <property name="size">130</property>
  <property name="supply">3 to 6 V</property>
  <property name="connector">2 flying leads</property>
  <property name="board connector">relay + 5V</property>
 </properties>
 <description>Small brushed DC motor (130 size) with the kit's yellow four-blade propeller and two flying leads. It is switched by the relay module and powered from the 5V connector of the MakerBuddy IoT Kit board, never straight from a GPIO pin. Swapping the leads reverses it. https://makerbuddy.cc</description>
 <views>
  <iconView>
   <layers image="icon/dc-motor-fan_icon.svg">
    <layer layerId="icon"/>
   </layers>
  </iconView>
  <breadboardView>
   <layers image="breadboard/dc-motor-fan_breadboard.svg">
    <layer layerId="breadboard"/>
   </layers>
  </breadboardView>
  <schematicView>
   <layers image="schematic/dc-motor-fan_schematic.svg">
    <layer layerId="schematic"/>
   </layers>
  </schematicView>
  <pcbView>
   <layers image="pcb/dc-motor-fan_pcb.svg">
    <layer layerId="copper0"/>
    <layer layerId="silkscreen"/>
    <layer layerId="copper1"/>
   </layers>
  </pcbView>
 </views>
 <connectors>
  <connector id="connector0" name="M+" type="male">
   <description>Motor lead, red. To the relay's NO terminal; the relay's COM goes to the board's 5V connector.</description>
   <views>
    <breadboardView><p layer="breadboard" svgId="connector0pin"/></breadboardView>
    <schematicView><p layer="schematic" svgId="connector0pin" terminalId="connector0terminal"/></schematicView>
    <pcbView><p layer="copper0" svgId="connector0pin"/><p layer="copper1" svgId="connector0pin"/></pcbView>
   </views>
  </connector>
  <connector id="connector1" name="M-" type="male">
   <description>Motor lead, black. To GND.</description>
   <views>
    <breadboardView><p layer="breadboard" svgId="connector1pin"/></breadboardView>
    <schematicView><p layer="schematic" svgId="connector1pin" terminalId="connector1terminal"/></schematicView>
    <pcbView><p layer="copper0" svgId="connector1pin"/><p layer="copper1" svgId="connector1pin"/></pcbView>
   </views>
  </connector>
 </connectors>
 <buses>
 </buses>
</module>
