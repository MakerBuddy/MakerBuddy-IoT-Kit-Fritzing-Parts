<?xml version="1.0" encoding="UTF-8"?>
<module fritzingVersion="1.0.2" moduleId="makerbuddy-kit-hc-sr04-r2" referenceFile="hc-sr04-fixed-cable.fzp">
 <version>1</version>
 <author>MakerBuddy (https://makerbuddy.cc)</author>
 <title>HC-SR04 ultrasonic distance sensor with fixed cable and plug (MakerBuddy)</title>
 <label>US</label>
 <date>2026-11-24</date>
 <url>https://github.com/MakerBuddy/MakerBuddy-IoT-Kit-Fritzing-Parts</url>
 <tags>
  <tag>MakerBuddy</tag>
  <tag>IoT Kit</tag>
  <tag>HC-SR04</tag>
  <tag>ultrasonic</tag>
  <tag>distance</tag>
  <tag>sensor</tag>
 </tags>
 <properties>
  <property name="family">MakerBuddy distance sensor</property>
  <property name="type">distance sensor</property>
  <property name="sensor">HC-SR04</property>
  <property name="interface">trigger + echo</property>
  <property name="connector">4 pins, 2.54 mm</property>
  <property name="board connector">HC-SR04</property>
  <property name="cable">fixed, with plug</property>
 </properties>
 <description>HC-SR04 ultrasonic distance sensor, 2 cm to 4 m. Pins left to right: Vcc, Trig, Echo, Gnd. On the MakerBuddy IoT Kit board it uses the HC-SR04 connector, printed VCC GND 2 15: Trig goes to 15 and Echo to 2, so the two middle wires cross. The kit part carries a 4-pin JST adapter on its back. This part comes with the kit's 4-wire cable and its plug: drop the plug on the HC-SR04 connector of the MakerBuddy IoT Kit board and all 4 pins connect at once. https://makerbuddy.cc</description>
