<?xml version="1.0" encoding="UTF-8"?>
<module fritzingVersion="1.0.2" moduleId="makerbuddy-kit-ds18b20-probe-r1" referenceFile="ds18b20-probe.fzp">
 <version>1</version>
 <author>MakerBuddy (https://makerbuddy.cc)</author>
 <title>DS18B20 waterproof temperature probe with JST plug (MakerBuddy)</title>
 <label>T</label>
 <date>2026-11-24</date>
 <url>https://github.com/MakerBuddy/MakerBuddy-IoT-Kit-Fritzing-Parts</url>
 <tags>
  <tag>MakerBuddy</tag>
  <tag>IoT Kit</tag>
  <tag>DS18B20</tag>
  <tag>temperature</tag>
  <tag>probe</tag>
  <tag>1-Wire</tag>
  <tag>sensor</tag>
 </tags>
 <properties>
  <property name="family">MakerBuddy temperature probe</property>
  <property name="type">temperature probe</property>
  <property name="sensor">DS18B20</property>
  <property name="interface">1-Wire</property>
  <property name="connector">JST-XH 3-pin plug</property>
  <property name="board connector">26</property>
 </properties>
 <description>DS18B20 digital temperature sensor in a waterproof stainless-steel tube on a lead ending in a JST-XH plug: DQ (yellow), VCC (red), GND (black). Plugs into connector 26 of the MakerBuddy IoT Kit board, the connector with the 4.7 k 1-Wire pull-up. Drawn with the lead shortened. https://makerbuddy.cc</description>
 <views>
  <iconView>
   <layers image="icon/ds18b20-probe_icon.svg">
    <layer layerId="icon"/>
   </layers>
  </iconView>
  <breadboardView>
   <layers image="breadboard/ds18b20-probe_breadboard.svg">
    <layer layerId="breadboard"/>
   </layers>
  </breadboardView>
  <schematicView>
   <layers image="schematic/ds18b20-probe_schematic.svg">
    <layer layerId="schematic"/>
   </layers>
  </schematicView>
  <pcbView>
   <layers image="pcb/ds18b20-probe_pcb.svg">
    <layer layerId="copper0"/>
    <layer layerId="silkscreen"/>
    <layer layerId="copper1"/>
   </layers>
  </pcbView>
 </views>
 <connectors>
  <connector id="connector0" name="DQ" type="male">
   <description>1-Wire data (yellow wire). On the board: connector 26, which has the 4.7 k pull-up.</description>
   <views>
    <breadboardView><p layer="breadboard" svgId="connector0pin"/></breadboardView>
    <schematicView><p layer="schematic" svgId="connector0pin" terminalId="connector0terminal"/></schematicView>
    <pcbView><p layer="copper0" svgId="connector0pin"/><p layer="copper1" svgId="connector0pin"/></pcbView>
   </views>
  </connector>
  <connector id="connector1" name="VCC" type="male">
   <description>Supply, 3.0 to 5.5 V (red wire)</description>
   <views>
    <breadboardView><p layer="breadboard" svgId="connector1pin"/></breadboardView>
    <schematicView><p layer="schematic" svgId="connector1pin" terminalId="connector1terminal"/></schematicView>
    <pcbView><p layer="copper0" svgId="connector1pin"/><p layer="copper1" svgId="connector1pin"/></pcbView>
   </views>
  </connector>
  <connector id="connector2" name="GND" type="male">
   <description>Ground (black wire)</description>
   <views>
    <breadboardView><p layer="breadboard" svgId="connector2pin"/></breadboardView>
    <schematicView><p layer="schematic" svgId="connector2pin" terminalId="connector2terminal"/></schematicView>
    <pcbView><p layer="copper0" svgId="connector2pin"/><p layer="copper1" svgId="connector2pin"/></pcbView>
   </views>
  </connector>
 </connectors>
 <buses>
 </buses>
</module>
