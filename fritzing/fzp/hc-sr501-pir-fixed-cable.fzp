<?xml version="1.0" encoding="UTF-8"?>
<module fritzingVersion="1.0.2" moduleId="makerbuddy-kit-hc-sr501-pir-r2" referenceFile="hc-sr501-pir-fixed-cable.fzp">
 <version>1</version>
 <author>MakerBuddy (https://makerbuddy.cc)</author>
 <title>HC-SR501 PIR motion sensor with fixed cable and plug (MakerBuddy)</title>
 <label>PIR</label>
 <date>2026-11-24</date>
 <url>https://github.com/MakerBuddy/MakerBuddy-IoT-Kit-Fritzing-Parts</url>
 <tags>
  <tag>MakerBuddy</tag>
  <tag>IoT Kit</tag>
  <tag>HC-SR501</tag>
  <tag>PIR</tag>
  <tag>motion</tag>
  <tag>sensor</tag>
 </tags>
 <properties>
  <property name="family">MakerBuddy motion sensor</property>
  <property name="type">motion sensor</property>
  <property name="sensor">HC-SR501</property>
  <property name="interface">digital</property>
  <property name="connector">JST-XH 3-pin</property>
  <property name="board connector">18</property>
  <property name="cable">fixed, with plug</property>
 </properties>
 <description>HC-SR501 passive-infrared motion sensor with the MakerBuddy JST adapter. 3-pin JST-XH socket: OUT, VCC, GND. Plugs into connector 18 of the MakerBuddy IoT Kit board. This part comes with the kit's 3-wire cable and its plug: drop the plug on connector 18 of the MakerBuddy IoT Kit board and all 3 pins connect at once. https://makerbuddy.cc</description>
