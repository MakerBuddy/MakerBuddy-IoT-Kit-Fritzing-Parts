<?xml version="1.0" encoding="UTF-8"?>
<module fritzingVersion="1.0.2" moduleId="makerbuddy-kit-sg90-servo-flex-r1" referenceFile="sg90-servo-flex.fzp">
 <version>1</version>
 <author>MakerBuddy (https://makerbuddy.cc)</author>
 <title>SG90 micro servo, for a flexible lead (MakerBuddy)</title>
 <label>M</label>
 <date>2026-11-24</date>
 <url>https://github.com/MakerBuddy/MakerBuddy-IoT-Kit-Fritzing-Parts</url>
 <tags>
  <tag>MakerBuddy</tag>
  <tag>IoT Kit</tag>
  <tag>SG90</tag>
  <tag>servo</tag>
  <tag>motor</tag>
  <tag>actuator</tag>
 </tags>
 <properties>
  <property name="family">MakerBuddy micro servo</property>
  <property name="type">micro servo</property>
  <property name="model">SG90</property>
  <property name="interface">PWM</property>
  <property name="connector">JST-XH 3-pin plug</property>
  <property name="board connector">19</property>
  <property name="cable">flexible (wires to a plug part)</property>
 </properties>
 <description>SG90 9 g micro servo, 0 to 180 degrees: PWM (orange), VCC (red), GND (brown). This version is for a flexible lead: its pins are the three wire ends of its lead. Draw Fritzing wires from them to its lead plug, then drag the plug onto the board. https://makerbuddy.cc</description>
 <views>
  <iconView>
   <layers image="icon/sg90-servo-flex_icon.svg">
    <layer layerId="icon"/>
   </layers>
  </iconView>
  <breadboardView>
   <layers image="breadboard/sg90-servo-flex_breadboard.svg">
    <layer layerId="breadboard"/>
   </layers>
  </breadboardView>
  <schematicView>
   <layers image="schematic/sg90-servo-flex_schematic.svg">
    <layer layerId="schematic"/>
   </layers>
  </schematicView>
  <pcbView>
   <layers image="pcb/sg90-servo-flex_pcb.svg">
    <layer layerId="copper0"/>
    <layer layerId="silkscreen"/>
    <layer layerId="copper1"/>
   </layers>
  </pcbView>
 </views>
 <connectors>
  <connector id="connector0" name="PWM" type="male">
   <description>Control signal (orange wire). On the board: connector 19 (GPIO 19).</description>
   <views>
    <breadboardView><p layer="breadboard" svgId="connector0pin"/></breadboardView>
    <schematicView><p layer="schematic" svgId="connector0pin" terminalId="connector0terminal"/></schematicView>
    <pcbView><p layer="copper0" svgId="connector0pin"/><p layer="copper1" svgId="connector0pin"/></pcbView>
   </views>
  </connector>
  <connector id="connector1" name="VCC" type="male">
   <description>5 V supply (red wire)</description>
   <views>
    <breadboardView><p layer="breadboard" svgId="connector1pin"/></breadboardView>
    <schematicView><p layer="schematic" svgId="connector1pin" terminalId="connector1terminal"/></schematicView>
    <pcbView><p layer="copper0" svgId="connector1pin"/><p layer="copper1" svgId="connector1pin"/></pcbView>
   </views>
  </connector>
  <connector id="connector2" name="GND" type="male">
   <description>Ground (brown wire)</description>
   <views>
    <breadboardView><p layer="breadboard" svgId="connector2pin"/></breadboardView>
    <schematicView><p layer="schematic" svgId="connector2pin" terminalId="connector2terminal"/></schematicView>
    <pcbView><p layer="copper0" svgId="connector2pin"/><p layer="copper1" svgId="connector2pin"/></pcbView>
   </views>
  </connector>
 </connectors>
 <buses>
 </buses>
</module>
