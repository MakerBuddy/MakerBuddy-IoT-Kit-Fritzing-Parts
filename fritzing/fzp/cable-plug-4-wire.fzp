<?xml version="1.0" encoding="UTF-8"?>
<module fritzingVersion="1.0.2" moduleId="makerbuddy-kit-cable-plug-4-wire-r2" referenceFile="cable-plug-4-wire.fzp">
 <version>1</version>
 <author>MakerBuddy (https://makerbuddy.cc)</author>
 <title>Kit cable plug, 4 wires (MakerBuddy)</title>
 <label>P</label>
 <date>2026-11-24</date>
 <url>https://github.com/MakerBuddy/MakerBuddy-IoT-Kit-Fritzing-Parts</url>
 <tags>
  <tag>MakerBuddy</tag>
  <tag>IoT Kit</tag>
  <tag>JST-XH</tag>
  <tag>plug</tag>
  <tag>cable</tag>
 </tags>
 <properties>
  <property name="family">MakerBuddy cable plug</property>
  <property name="type">cable plug</property>
  <property name="pins">4</property>
  <property name="wires">red, white, blue, yellow</property>
 </properties>
 <description>JST-XH cable plug with 4 pins (VCC, GND, S1, S2) and a short stub of each wire. Press anywhere on the plug to move it as one piece. Drop it on a socket of the MakerBuddy IoT Kit board and every pin connects at once. Draw Fritzing wires from the stub ends to the part at the other end of the cable; they follow the plug when it is dragged. For the HC-SR04, UART and I2C connectors. https://makerbuddy.cc</description>
 <views>
  <iconView>
   <layers image="icon/cable-plug-4-wire_icon.svg">
    <layer layerId="icon"/>
   </layers>
  </iconView>
  <breadboardView>
   <layers image="breadboard/cable-plug-4-wire_breadboard.svg">
    <layer layerId="breadboard"/>
   </layers>
  </breadboardView>
  <schematicView>
   <layers image="schematic/cable-plug-4-wire_schematic.svg">
    <layer layerId="schematic"/>
   </layers>
  </schematicView>
  <pcbView>
   <layers image="pcb/cable-plug-4-wire_pcb.svg">
    <layer layerId="copper0"/>
    <layer layerId="silkscreen"/>
    <layer layerId="copper1"/>
   </layers>
  </pcbView>
 </views>
 <connectors>
  <connector id="connector0" name="VCC" type="male">
   <description>Plug pin: 5 V. Goes into the socket.</description>
   <views>
    <breadboardView><p layer="breadboard" svgId="connector0pin" hybrid="yes"/></breadboardView>
    <schematicView><p layer="schematic" svgId="connector0pin" terminalId="connector0terminal"/></schematicView>
    <pcbView><p layer="copper0" svgId="connector0pin"/><p layer="copper1" svgId="connector0pin"/></pcbView>
   </views>
  </connector>
  <connector id="connector1" name="GND" type="male">
   <description>Plug pin: ground. Goes into the socket.</description>
   <views>
    <breadboardView><p layer="breadboard" svgId="connector1pin" hybrid="yes"/></breadboardView>
    <schematicView><p layer="schematic" svgId="connector1pin" terminalId="connector1terminal"/></schematicView>
    <pcbView><p layer="copper0" svgId="connector1pin"/><p layer="copper1" svgId="connector1pin"/></pcbView>
   </views>
  </connector>
  <connector id="connector2" name="S1" type="male">
   <description>Plug pin: first signal: SCL on I2C, 2 on HC-SR04. Goes into the socket.</description>
   <views>
    <breadboardView><p layer="breadboard" svgId="connector2pin" hybrid="yes"/></breadboardView>
    <schematicView><p layer="schematic" svgId="connector2pin" terminalId="connector2terminal"/></schematicView>
    <pcbView><p layer="copper0" svgId="connector2pin"/><p layer="copper1" svgId="connector2pin"/></pcbView>
   </views>
  </connector>
  <connector id="connector3" name="S2" type="male">
   <description>Plug pin: second signal: SDA on I2C, 15 on HC-SR04. Goes into the socket.</description>
   <views>
    <breadboardView><p layer="breadboard" svgId="connector3pin" hybrid="yes"/></breadboardView>
    <schematicView><p layer="schematic" svgId="connector3pin" terminalId="connector3terminal"/></schematicView>
    <pcbView><p layer="copper0" svgId="connector3pin"/><p layer="copper1" svgId="connector3pin"/></pcbView>
   </views>
  </connector>
  <connector id="connector4" name="VCC wire" type="male">
   <description>The red wire of this pin. A Fritzing wire to the sensor starts here.</description>
   <views>
    <breadboardView><p layer="breadboard" svgId="connector4pin"/></breadboardView>
    <schematicView><p layer="schematic" svgId="connector4pin" terminalId="connector4terminal"/></schematicView>
    <pcbView><p layer="copper0" svgId="connector4pin"/><p layer="copper1" svgId="connector4pin"/></pcbView>
   </views>
  </connector>
  <connector id="connector5" name="GND wire" type="male">
   <description>The white wire of this pin. A Fritzing wire to the sensor starts here.</description>
   <views>
    <breadboardView><p layer="breadboard" svgId="connector5pin"/></breadboardView>
    <schematicView><p layer="schematic" svgId="connector5pin" terminalId="connector5terminal"/></schematicView>
    <pcbView><p layer="copper0" svgId="connector5pin"/><p layer="copper1" svgId="connector5pin"/></pcbView>
   </views>
  </connector>
  <connector id="connector6" name="S1 wire" type="male">
   <description>The blue wire of this pin. A Fritzing wire to the sensor starts here.</description>
   <views>
    <breadboardView><p layer="breadboard" svgId="connector6pin"/></breadboardView>
    <schematicView><p layer="schematic" svgId="connector6pin" terminalId="connector6terminal"/></schematicView>
    <pcbView><p layer="copper0" svgId="connector6pin"/><p layer="copper1" svgId="connector6pin"/></pcbView>
   </views>
  </connector>
  <connector id="connector7" name="S2 wire" type="male">
   <description>The yellow wire of this pin. A Fritzing wire to the sensor starts here.</description>
   <views>
    <breadboardView><p layer="breadboard" svgId="connector7pin"/></breadboardView>
    <schematicView><p layer="schematic" svgId="connector7pin" terminalId="connector7terminal"/></schematicView>
    <pcbView><p layer="copper0" svgId="connector7pin"/><p layer="copper1" svgId="connector7pin"/></pcbView>
   </views>
  </connector>
 </connectors>
 <buses>
  <bus id="wire0">
   <nodeMember connectorId="connector0"/>
   <nodeMember connectorId="connector4"/>
  </bus>
  <bus id="wire1">
   <nodeMember connectorId="connector1"/>
   <nodeMember connectorId="connector5"/>
  </bus>
  <bus id="wire2">
   <nodeMember connectorId="connector2"/>
   <nodeMember connectorId="connector6"/>
  </bus>
  <bus id="wire3">
   <nodeMember connectorId="connector3"/>
   <nodeMember connectorId="connector7"/>
  </bus>
 </buses>
</module>
