<?xml version="1.0" encoding="UTF-8"?>
<module fritzingVersion="1.0.2" moduleId="makerbuddy-kit-lamp-r1" referenceFile="lamp.fzp">
 <version>1</version>
 <author>MakerBuddy (https://makerbuddy.cc)</author>
 <title>6 V lamp in a holder with leads (MakerBuddy)</title>
 <label>L</label>
 <date>2026-11-24</date>
 <url>https://github.com/MakerBuddy/MakerBuddy-IoT-Kit-Fritzing-Parts</url>
 <tags>
  <tag>MakerBuddy</tag>
  <tag>IoT Kit</tag>
  <tag>lamp</tag>
  <tag>bulb</tag>
  <tag>light</tag>
  <tag>actuator</tag>
 </tags>
 <properties>
  <property name="family">MakerBuddy filament lamp</property>
  <property name="type">filament lamp</property>
  <property name="rating">6 V</property>
  <property name="holder">E10 screw</property>
  <property name="connector">2 flying leads</property>
  <property name="board connector">relay + 5V</property>
 </properties>
 <description>Small 6 V filament lamp in a brass E10 screw holder with two flying leads. It is switched by the relay module and powered from the 5V connector of the MakerBuddy IoT Kit board. A filament lamp works either way round. https://makerbuddy.cc</description>
 <views>
  <iconView>
   <layers image="icon/lamp_icon.svg">
    <layer layerId="icon"/>
   </layers>
  </iconView>
  <breadboardView>
   <layers image="breadboard/lamp_breadboard.svg">
    <layer layerId="breadboard"/>
   </layers>
  </breadboardView>
  <schematicView>
   <layers image="schematic/lamp_schematic.svg">
    <layer layerId="schematic"/>
   </layers>
  </schematicView>
  <pcbView>
   <layers image="pcb/lamp_pcb.svg">
    <layer layerId="copper0"/>
    <layer layerId="silkscreen"/>
    <layer layerId="copper1"/>
   </layers>
  </pcbView>
 </views>
 <connectors>
  <connector id="connector0" name="L1" type="male">
   <description>Lamp lead, orange. To the relay's NO terminal; the relay's COM goes to the board's 5V connector.</description>
   <views>
    <breadboardView><p layer="breadboard" svgId="connector0pin"/></breadboardView>
    <schematicView><p layer="schematic" svgId="connector0pin" terminalId="connector0terminal"/></schematicView>
    <pcbView><p layer="copper0" svgId="connector0pin"/><p layer="copper1" svgId="connector0pin"/></pcbView>
   </views>
  </connector>
  <connector id="connector1" name="L2" type="male">
   <description>Lamp lead, black. To GND.</description>
   <views>
    <breadboardView><p layer="breadboard" svgId="connector1pin"/></breadboardView>
    <schematicView><p layer="schematic" svgId="connector1pin" terminalId="connector1terminal"/></schematicView>
    <pcbView><p layer="copper0" svgId="connector1pin"/><p layer="copper1" svgId="connector1pin"/></pcbView>
   </views>
  </connector>
 </connectors>
 <buses>
 </buses>
</module>
