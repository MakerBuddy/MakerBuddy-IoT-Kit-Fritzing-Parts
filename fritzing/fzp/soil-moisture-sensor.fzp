<?xml version="1.0" encoding="UTF-8"?>
<module fritzingVersion="1.0.2" moduleId="makerbuddy-kit-soil-moisture-sensor-r1" referenceFile="soil-moisture-sensor.fzp">
 <version>1</version>
 <author>MakerBuddy (https://makerbuddy.cc)</author>
 <title>Capacitive soil moisture sensor v2.0 (MakerBuddy)</title>
 <label>SM</label>
 <date>2026-11-24</date>
 <url>https://github.com/MakerBuddy/MakerBuddy-IoT-Kit-Fritzing-Parts</url>
 <tags>
  <tag>MakerBuddy</tag>
  <tag>IoT Kit</tag>
  <tag>soil moisture</tag>
  <tag>capacitive</tag>
  <tag>sensor</tag>
  <tag>analog</tag>
 </tags>
 <properties>
  <property name="family">MakerBuddy soil moisture sensor</property>
  <property name="type">soil moisture sensor</property>
  <property name="sensor">capacitive v2.0</property>
  <property name="interface">analog</property>
  <property name="connector">JST 3-pin</property>
  <property name="board connector">32</property>
 </properties>
 <description>Capacitive soil moisture sensor v2.0: a corrosion-free blade with its electronics at the top end and a 3-pin JST socket: GND, VCC, AOUT. Plugs into connector 32 of the MakerBuddy IoT Kit board. Push it into the soil only as far as the printed line and keep the top end dry. https://makerbuddy.cc</description>
 <views>
  <iconView>
   <layers image="icon/soil-moisture-sensor_icon.svg">
    <layer layerId="icon"/>
   </layers>
  </iconView>
  <breadboardView>
   <layers image="breadboard/soil-moisture-sensor_breadboard.svg">
    <layer layerId="breadboard"/>
   </layers>
  </breadboardView>
  <schematicView>
   <layers image="schematic/soil-moisture-sensor_schematic.svg">
    <layer layerId="schematic"/>
   </layers>
  </schematicView>
  <pcbView>
   <layers image="pcb/soil-moisture-sensor_pcb.svg">
    <layer layerId="copper0"/>
    <layer layerId="silkscreen"/>
    <layer layerId="copper1"/>
   </layers>
  </pcbView>
 </views>
 <connectors>
  <connector id="connector0" name="AOUT" type="female">
   <description>Analog output: falls as the soil gets wetter. On the board: connector 32 (GPIO 32).</description>
   <views>
    <breadboardView><p layer="breadboard" svgId="connector0pin"/></breadboardView>
    <schematicView><p layer="schematic" svgId="connector0pin" terminalId="connector0terminal"/></schematicView>
    <pcbView><p layer="copper0" svgId="connector0pin"/><p layer="copper1" svgId="connector0pin"/></pcbView>
   </views>
  </connector>
  <connector id="connector1" name="VCC" type="female">
   <description>Supply, 3.3 to 5.5 V</description>
   <views>
    <breadboardView><p layer="breadboard" svgId="connector1pin"/></breadboardView>
    <schematicView><p layer="schematic" svgId="connector1pin" terminalId="connector1terminal"/></schematicView>
    <pcbView><p layer="copper0" svgId="connector1pin"/><p layer="copper1" svgId="connector1pin"/></pcbView>
   </views>
  </connector>
  <connector id="connector2" name="GND" type="female">
   <description>Ground</description>
   <views>
    <breadboardView><p layer="breadboard" svgId="connector2pin"/></breadboardView>
    <schematicView><p layer="schematic" svgId="connector2pin" terminalId="connector2terminal"/></schematicView>
    <pcbView><p layer="copper0" svgId="connector2pin"/><p layer="copper1" svgId="connector2pin"/></pcbView>
   </views>
  </connector>
 </connectors>
 <buses>
 </buses>
</module>
