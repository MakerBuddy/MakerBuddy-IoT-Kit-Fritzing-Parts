<?xml version="1.0" encoding="UTF-8"?>
<module fritzingVersion="1.0.2" moduleId="makerbuddy-kit-soil-moisture-sensor-flex-r2" referenceFile="soil-moisture-sensor-flex.fzp">
 <version>1</version>
 <author>MakerBuddy (https://makerbuddy.cc)</author>
 <title>Capacitive soil moisture sensor v2.0, for a flexible cable (MakerBuddy)</title>
 <label>SM</label>
 <date>2026-11-24</date>
 <url>https://github.com/MakerBuddy/MakerBuddy-IoT-Kit-Fritzing-Parts</url>
 <tags>
  <tag>MakerBuddy</tag>
  <tag>IoT Kit</tag>
  <tag>soil moisture</tag>
  <tag>capacitive</tag>
  <tag>sensor</tag>
  <tag>analog</tag>
 </tags>
 <properties>
  <property name="family">MakerBuddy soil moisture sensor</property>
  <property name="type">soil moisture sensor</property>
  <property name="sensor">capacitive v2.0</property>
  <property name="interface">analog</property>
  <property name="connector">JST 3-pin</property>
  <property name="board connector">32</property>
  <property name="cable">flexible (wires to a plug part)</property>
 </properties>
 <description>Capacitive soil moisture sensor v2.0: a corrosion-free blade with its electronics at the top end and a 3-pin JST socket: GND, VCC, AOUT. Plugs into connector 32 of the MakerBuddy IoT Kit board. Push it into the soil only as far as the printed line and keep the top end dry. This version is for a flexible cable: the cable's plug sits in its socket and its pins are the ends of the 3 wire stubs that leave the plug. Draw Fritzing wires from them to a MakerBuddy cable plug, then drag the plug onto the board. https://makerbuddy.cc</description>
